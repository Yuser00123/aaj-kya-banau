# Copy to .env for local runs. On Render, set these in the dashboard (sync:false for the key).
# LLM_PROVIDER: openai (Gemini OpenAI-compat endpoint) | ollama (local) | mock (no network)
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=your-gemini-api-key
# Optional
REPO_URL=https://github.com/Yuser00123/aaj-kya-banau
